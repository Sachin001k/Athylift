# Copy to .env and fill in. Never commit .env.

# Used by the browser app (safe to expose: access is controlled by RLS policies).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Used only by `npm run db:setup`. NEVER prefix these with VITE_ (that would ship them to the browser).
SUPABASE_SERVICE_ROLE_KEY=
# One of these is required to create tables:
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=
